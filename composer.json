{
    "name": "tequila/k8schema",
    "description": "PHP class definitions of Kubernetes API resources",
    "type": "library",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "Tequila\\K8Schema\\": "src/"
        }
    },
    "authors": [
        {
            "name": "petr-buchin",
            "email": "petrbuchyn@gmail.com"
        }
    ],
    "scripts": {
        "cs": "./tools/php-cs-fixer/vendor/bin/php-cs-fixer fix",
        "cs-check": "./tools/php-cs-fixer/vendor/bin/php-cs-fixer check",
        "tools-update": "composer update -d tools/php-cs-fixer --no-scripts",
        "generate": "./bin/generate",
        "push-to-branch": "./bin/push-to-branch"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://composer.tequila.dev/"
        }
    ]
}
